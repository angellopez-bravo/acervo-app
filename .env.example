# Copia este archivo a .env.local y rellena los valores. .env.local no se sube a git.

# Clave de la API de Anthropic (solo en el servidor).
ANTHROPIC_API_KEY=

# Codigo que protege /api/analyze y /api/profile. Elige uno largo; se pide una vez por dispositivo.
# En produccion es obligatorio: sin el, las rutas de IA rechazan toda peticion.
ACCESS_CODE=
